[user]
	name = Nathaniel Joselson
[alias]
	lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --decorate=full
	stoic = !git commit -m \"$(curl -s --max-time 3 https://stoicquotesapi.com/v1/api/quotes/random | jq -r '.body' || echo 'memento mori')\"
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[include]
	path = ~/.gitconfig.local
[gpg]
	format = ssh
[commit]
	gpgsign = true
